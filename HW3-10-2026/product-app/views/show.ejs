<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - Chi tiết sản phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="app-navbar">
        <div class="container py-3 d-flex align-items-center justify-content-between">
            <a href="/" class="d-flex align-items-center gap-2 text-dark fw-bold">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <span>ProductHub</span>
            </a>
            <a href="/" class="btn btn-soft"><i class="bi bi-arrow-left me-1"></i> Danh sách</a>
        </div>
    </nav>

    <main class="container page-shell">
        <div class="mb-4">
            <div class="text-secondary small mb-2">
                <a href="/" class="text-secondary">Sản phẩm</a>
                <span class="mx-2">/</span>
                <span>Chi tiết</span>
            </div>
            <h1 class="page-title mb-0"><%= product.name %></h1>
        </div>

        <section class="detail-card">
            <div class="row g-0">
                <div class="col-lg-6 detail-image-wrap">
                    <img src="<%= product.image %>" class="detail-image" alt="<%= product.name %>">
                </div>

                <div class="col-lg-6 detail-content d-flex flex-column">
                    <div class="mb-4">
                        <div class="detail-label mb-2">Giá sản phẩm</div>
                        <p class="card-text">Price: <%= product.price.toLocaleString('vi-VN') %> VNĐ</p>
                    </div>

                    <div class="mb-4">
                        <div class="detail-label mb-2">Số lượng trong kho</div>
                        <div class="detail-value">
                            <span class="stock-badge"><i class="bi bi-box2"></i> <%= product.quantity %> sản phẩm</span>
                        </div>
                    </div>

                    <div class="mt-auto d-flex flex-column flex-sm-row gap-2 pt-3">
                        <a href="/edit/<%= product._id %>" class="btn btn-primary px-4">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                        </a>
                        <a href="/" class="btn btn-soft px-4">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
