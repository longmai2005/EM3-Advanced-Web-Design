<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý sản phẩm</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="app-navbar">
        <div class="container py-3 d-flex align-items-center justify-content-between">
            <a href="/" class="d-flex align-items-center gap-2 text-dark fw-bold">
                <span class="brand-mark"><i class="bi bi-box-seam"></i></span>
                <span>ProductApp</span>
            </a>
            <a href="/add" class="btn btn-primary px-3">
                <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
            </a>
        </div>
    </nav>

    <main class="container page-shell">
        <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3 mb-4">
            <div>
                <h1 class="page-title">Danh sách sản phẩm</h1>
                <p class="page-subtitle">Quản lý, tìm kiếm và cập nhật sản phẩm trong hệ thống.</p>
            </div>
            <div class="text-secondary small">
                <i class="bi bi-boxes me-1"></i>
                <strong><%= products.length %></strong> sản phẩm
            </div>
        </div>

        <div class="toolbar mb-4">
            <form action="/search" method="GET" class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    <div class="search-wrap">
                        <i class="bi bi-search"></i>
                        <input class="form-control search-input" type="text" name="q" placeholder="Tìm sản phẩm theo tên..." required>
                    </div>
                </div>
                <div class="col-6 col-md-auto">
                    <button class="btn btn-primary w-100 px-md-4" type="submit">Tìm kiếm</button>
                </div>
                <div class="col-6 col-md-auto">
                    <a class="btn btn-soft w-100 px-md-4" href="/">Làm mới</a>
                </div>
            </form>
        </div>

        <% if (products.length === 0) { %>
            <section class="empty-state">
                <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                <h3 class="h5 fw-bold">Chưa có sản phẩm</h3>
                <p class="text-secondary mb-4">Hãy thêm sản phẩm đầu tiên để bắt đầu quản lý.</p>
                <a href="/add" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Thêm sản phẩm
                </a>
            </section>
        <% } else { %>
            <section class="product-grid">
                <% products.forEach(product => { %>
                    <article class="product-card">
                        <a href="/products/<%= product._id %>" class="product-image-wrap d-block">
                            <img src="<%= product.image %>" class="product-image" alt="<%= product.name %>">
                        </a>

                        <div class="product-card-body">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                <h2 class="product-name"><%= product.name %></h2>
                                <span class="stock-badge flex-shrink-0">
                                    <i class="bi bi-stack"></i> <%= product.quantity %>
                                </span>
                            </div>

                            <p class="card-text"> Price: <%= product.price.toLocaleString('vi-VN') %> VNĐ</p>

                            <div class="action-row">
                                <a href="/products/<%= product._id %>" class="btn btn-primary">
                                    <i class="bi bi-eye me-1"></i> Chi tiết
                                </a>

                                <a href="/edit/<%= product._id %>" class="btn btn-soft icon-btn edit-button" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <form action="/delete/<%= product._id %>" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                    <button type="submit" class="btn btn-outline-danger icon-btn" title="Xóa">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                <% }); %>
            </section>
        <% } %>
    </main>
</body>
</html>
